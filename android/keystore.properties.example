# Copy this to android/keystore.properties and fill it in.
#
# That file is gitignored and must stay that way: together with the .jks it
# names, it is the only thing that can publish an update to the Play listing.
# If both are lost, the app cannot be updated, only republished under a new
# package name, which means losing every install and review.
#
# Back the .jks up somewhere that is not this laptop. A password manager
# attachment or an encrypted drive, not Google Drive in plain sight.

# Where the keystore lives. Keep it OUTSIDE the repository.
storeFile=/Users/wit/keys/linkupnaija-upload.jks

# The two passwords you chose when running keytool. They are often the same.
storePassword=
keyAlias=upload
keyPassword=
